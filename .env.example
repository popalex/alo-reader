# Copy to .env and adjust. .env is gitignored. The compose stack reads it because
# the Makefile passes --env-file .env and api/worker/migrate take it as env_file;
# for local non-Docker runs python-dotenv loads it (api/app/config.py). Real
# environment variables always win over this file.
#
# Every commented line below is the actual default from api/app/config.py, and a
# test asserts that, so the values here are what you get if you leave them alone.
#
# ── Before you expose an instance to the internet ────────────────────────────
# These five ship with values that are wrong for production:
#   POSTGRES_PASSWORD        "alo" is in this public repo
#   AUTH_MODE                "none" means no authentication at all
#   ALO_SITE_ADDRESS         a hostname here is what turns TLS on
#   APP_VERSION              otherwise /healthz reports 0.0.0+dev forever
#   GRAFANA_ADMIN_PASSWORD   only if you run the OTel overlay
# Everything else has a working default.

# ── Public address and TLS ───────────────────────────────────────────────────
# Caddy's site address. Left at :80 it serves plain HTTP, which is what `make up`
# and CI want. Set it to a hostname you control and Caddy obtains and renews a
# Let's Encrypt certificate on first request, then redirects HTTP to HTTPS. DNS
# must already point here and ports 80 and 443 must be reachable, because the
# ACME challenge uses both. Certificates persist in the caddy_data volume.
#ALO_SITE_ADDRESS=:80
#ALO_SITE_ADDRESS=reader.example.com

# The Clerk frontend API origin, which the SPA's Content-Security-Policy must allow.
# clerk-js is fetched from the host encoded in your publishable key: a pk_test_ key
# resolves to *.clerk.accounts.dev (the default below), a production pk_live_ key
# resolves to your own clerk.<your-domain>. Get this wrong with a live key and login
# fails with CSP errors in the console and nothing in the server log.
#ALO_CLERK_ORIGIN=https://clerk.example.com

# Who may reach Grafana through the public /grafana route (space-separated CIDRs).
# Loopback only by default, so remote access is a deliberate act: Grafana's admin
# password is fixed when it first creates the user, so an instance started once
# before you set GRAFANA_ADMIN_PASSWORD keeps admin/admin no matter what you set
# later. Widen this to your VPN or office range, not to 0.0.0.0/0.
#ALO_GRAFANA_ALLOW_IPS=127.0.0.1/32 ::1

# Build version, stamped into the image at build time and reported by
# /api/v1/healthz, the OpenAPI document and every OTel span. Set it to the tag you
# are deploying; it is the only way to tell which build is running.
#APP_VERSION=0.0.0+dev

# Postgres container credentials.
POSTGRES_USER=alo
POSTGRES_PASSWORD=alo
POSTGRES_DB=alo

# Connection string used by the api and worker. The host `postgres` is the
# compose service name; change only this line to point at managed Postgres.
DATABASE_URL=postgresql+asyncpg://alo:alo@postgres:5432/alo

# Connection pool, per process. POOL_SIZE must stay >= WORKER_MAX_CONCURRENCY or
# the worker's concurrent per-feed transactions starve waiting for a connection.
# RECYCLE bounds connection age; STATEMENT_TIMEOUT_MS is a server-side ceiling on
# any single statement and must exceed the largest maintenance batch.
#DB_POOL_SIZE=20
#DB_MAX_OVERFLOW=10
#DB_POOL_RECYCLE_S=1800
#DB_STATEMENT_TIMEOUT_MS=30000

# Auth mode: "clerk" (public instance) or "none" (single-user self-host).
# REQUIRED — the API refuses to boot without an explicit value; there is no
# default. AUTH_MODE=none disables auth entirely: ONLY run it behind a private
# network, VPN/Tailscale, or reverse-proxy auth (DESIGN.md §0.1).
# The dev overlay (`make dev`) defaults to "none" for local hacking.
AUTH_MODE=none

# Clerk settings (AUTH_MODE=clerk only). CLERK_ISSUER is your Clerk frontend
# API origin (also the JWT `iss` claim); JWKS is fetched from
# <issuer>/.well-known/jwks.json. CLERK_AUDIENCE is checked only when set
# (Clerk session tokens carry `aud` only if your JWT template adds one).
#CLERK_ISSUER=https://your-app.clerk.accounts.dev
#CLERK_AUDIENCE=
#CLERK_PUBLISHABLE_KEY=pk_test_...
#CLERK_WEBHOOK_SECRET=whsec_...

# Per-user API rate limit (token bucket, per API replica).
#RATE_LIMIT_RPS=10
#RATE_LIMIT_BURST=30

# Per-IP token bucket applied BEFORE authentication, bounding what an unauthenticated
# caller can cost (a DB lookup per bogus token, a signature verify per bogus JWT).
# Deliberately looser than the per-user bucket so a real user hits that one first.
# Keyed on the client IP Caddy injects as X-Real-IP. Per API replica.
#RATE_LIMIT_IP_RPS=50
#RATE_LIMIT_IP_BURST=120

# The unauthenticated routes (icons, the Clerk webhook, /config) get their own per-IP
# bucket, deliberately far looser: one cold page load fetches an icon per
# subscription, so sharing the API bucket would 429 a large account's own images.
#RATE_LIMIT_PUBLIC_RPS=200
#RATE_LIMIT_PUBLIC_BURST=600

# Minimum spacing (seconds) between manual per-feed refreshes, per API replica.
#SUBSCRIPTION_REFRESH_WINDOW_S=300

# Max personal access tokens a single user may hold (quota audit, DESIGN.md §1.4).
#QUOTA_API_TOKENS=20

# Minimum spacing (seconds) between /discover calls per user, per API replica.
# Discovery makes the server fetch an arbitrary page, so it's gated harder than
# the coarse global request bucket.
#DISCOVER_WINDOW_S=5

# Fetcher / poller (DESIGN.md §1.3). FETCH_CONTACT_URL is optional: if set, it's
# appended to the crawler User-Agent as "(+<url>)" so hosts can reach you — use a
# real, monitored address. Left unset, the UA is just "alo-reader/1.0". The caps
# bound per-fetch cost/abuse (total timeout, response size, redirect hops).
#FETCH_CONTACT_URL=https://your-site.example/contact
#FETCH_TIMEOUT_S=30
#FETCH_MAX_BYTES=5242880
#FETCH_MAX_REDIRECTS=5

# Comma-separated hostnames exempt from the SSRF private-range block (still must be
# http/https and resolvable). For trusted internal/test feed servers only — e.g. a
# fixture host on the compose network. Leave empty in production.
#FETCH_ALLOW_HOSTS=feedfixture

# Worker / poller (DESIGN.md §1.3). Claim loop cadence, batch size, lease, and
# the global concurrent-fetch cap.
#WORKER_POLL_INTERVAL_S=5
#WORKER_CLAIM_BATCH=50
# The lease must outlast the worst case time to drain one claimed batch, or a slow
# batch loses it mid-flight and another replica re-claims feeds still being fetched.
# Worst case is ceil(BATCH/CONCURRENCY) x FETCH_TIMEOUT_S plus per-host spacing.
#WORKER_LEASE_S=300
#WORKER_MAX_CONCURRENCY=20
# Entries persisted from a single fetch, so a feed advertising thousands of items
# cannot build one unbounded transaction. Newest N by publish date win.
#WORKER_MAX_ENTRIES_PER_FETCH=2000

# Per-origin-host politeness: max concurrent fetches to one host and the minimum
# spacing (seconds) between successive fetches to it.
#WORKER_PER_HOST_CONCURRENCY=1
#WORKER_PER_HOST_DELAY_S=1

# Fetch a feed's icon on its first successful poll (best-effort, SSRF-guarded).
# Prefers the feed's own artwork (<image>/<itunes:image>) over the site favicon;
# FAVICON_MAX_BYTES caps the favicon, FEED_IMAGE_MAX_BYTES the (larger) artwork.
#WORKER_FETCH_FAVICONS=true
#FAVICON_MAX_BYTES=102400
#FEED_IMAGE_MAX_BYTES=524288

# Size caps on the two endpoints that accept or fetch a document on a user's
# behalf: OPML uploads, and the HTML page /discover retrieves to look for feed
# links. Both reject anything larger rather than truncating.
#OPML_MAX_BYTES=1048576
#DISCOVER_MAX_BYTES=2097152

# Adaptive poll interval bounds (seconds): 15 min floor for active feeds, 24 h
# ceiling for dormant ones.
#WORKER_INTERVAL_FLOOR_S=900
#WORKER_INTERVAL_CEIL_S=86400

# Error backoff (seconds): base doubled per consecutive error, capped at 24 h.
#WORKER_BACKOFF_BASE_S=900
#WORKER_BACKOFF_CAP_S=86400

# Worker-embedded maintenance (WP-15): orphan-feed GC + retention purge run on this
# interval, jittered ±WORKER_MAINTENANCE_JITTER_S so N workers don't sweep in unison.
#WORKER_MAINTENANCE_INTERVAL_S=3600
#WORKER_MAINTENANCE_JITTER_S=300

# How long a deleted Clerk account is remembered so a retried webhook cannot recreate
# the local row (svix retries for about a day). Only relevant with AUTH_MODE=clerk.
#CLERK_TOMBSTONE_DAYS=7

# Delete a globally-deduped feed once it has had zero subscribers this many days.
#ORPHAN_GRACE_DAYS=7

# Purge read + unstarred entries older than this (days) once every subscriber has
# read them; starred kept forever, unread never purged (DESIGN.md §0.3).
#RETENTION_HORIZON_DAYS=90
# Retention purge deletes in batches of this many rows per transaction, so a large
# backlog never locks the whole entries table in one statement.
#RETENTION_PURGE_BATCH_SIZE=5000

# ── Backups ──────────────────────────────────────────────────────────────────
# The `backup` sidecar dumps the database nightly to the `backups` volume and
# keeps BACKUP_RETENTION_DAYS of them. Restore with scripts/restore.sh.
# These are read by deploy/backup.sh, not by the app, so they are not in
# api/app/config.py and not covered by the template drift test.
#BACKUP_SCHEDULE_UTC=03:30
#BACKUP_RETENTION_DAYS=14
# Take one immediately on container start as well as on the schedule. Useful the
# first time you bring a production stack up, so you are not a day from your
# first backup.
#BACKUP_ON_START=false
# zstd level. 10 is a good ratio for the time; 19 is much slower for a few percent.
#BACKUP_ZSTD_LEVEL=10
# Off-box copies. Empty means the backups only exist on this host's volume, which
# is not a backup if the host is what you lose. Set an rclone remote and every
# dump is copied there and pruned on the same retention. rclone takes its whole
# configuration from RCLONE_CONFIG_* variables in this file, so there is no
# separate config to mount -- see `rclone config` output for the names.
#BACKUP_RCLONE_REMOTE=s3:my-bucket/alo-reader
#RCLONE_CONFIG_S3_TYPE=s3
#RCLONE_CONFIG_S3_PROVIDER=AWS
#RCLONE_CONFIG_S3_ACCESS_KEY_ID=
#RCLONE_CONFIG_S3_SECRET_ACCESS_KEY=
#RCLONE_CONFIG_S3_REGION=eu-west-1

# ── Sentry (optional error reporting) ────────────────────────────────────────
# Off until SENTRY_DSN is set; nothing to install or rebuild. This runs ALONGSIDE
# OpenTelemetry below, it does not replace it: OTel still owns traces, metrics and
# log export to Loki, and Sentry only groups and alerts on errors.
#SENTRY_DSN=https://<key>@o0.ingest.sentry.io/0
# Tag events so staging and production don't share one issue stream.
#SENTRY_ENVIRONMENT=
# Sentry's own tracing, separate from OTel's. Leave at 0 unless you are deliberately
# not running Tempo: two tracing systems in one process double-instrument everything.
#SENTRY_TRACES_SAMPLE_RATE=0

# ── OpenTelemetry (Grafana LGTM) ─────────────────────────────────────────────
# Off by default. The OTel compose overlay (make otel-up) sets these; the browser
# SPA turns its own tracing on from /api/v1/config when OTEL_ENABLED is true.
#OTEL_ENABLED=false
#OTEL_SERVICE_NAME=alo-api
#OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
#OTEL_EXPORTER_OTLP_PROTOCOL=grpc
#OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=dev
#OTEL_TRACES_SAMPLER=parentbased_always_on
#OTEL_METRICS_EXEMPLAR_FILTER=trace_based
# Same-origin path the browser posts spans to (Caddy proxies /otlp → collector).
#OTEL_TRACES_URL=/otlp/v1/traces
# Grafana UI port published by the OTel overlay — bound to loopback (127.0.0.1) only.
# Public access is via Caddy's /grafana route, not this port.
#GRAFANA_PORT=3001
# Grafana login (anonymous access is disabled). The default password is "admin" — you
# MUST set GRAFANA_ADMIN_PASSWORD to a strong value before exposing this anywhere. Note:
# the password is applied on Grafana's FIRST start; if the otel-lgtm-data volume already
# exists, change it in the Grafana UI or reset the volume, since the env won't override it.
#GRAFANA_ADMIN_USER=admin
#GRAFANA_ADMIN_PASSWORD=change-me
# Grafana's external URL incl. the /grafana sub-path. Defaults to the dev origin; set it
# to your public URL in prod, e.g. https://example.com/grafana/
#GRAFANA_ROOT_URL=http://localhost:3000/grafana/

# ── Alert notifications (OTel overlay) ────────────────────────────────────────
# The three alerts (worker lag, 5xx rate, disk) are provisioned with the overlay and
# push to Pushover. Leave these unset and the alerts still show in Grafana, but
# nothing reaches your phone — see docs/ALERTS.md.
# Two different 30-character keys, and mixing them up is the usual mistake. The user
# key identifies you and is on the pushover.net dashboard the moment you log in. The
# API token identifies the sender and does not exist until you register an application
# at pushover.net/apps/build (call it alo-reader). Both are shown truncated here.
#ALO_PUSHOVER_USER_KEY=uQiRzp...
#ALO_PUSHOVER_API_TOKEN=azGDOR...
# Check both with ./scripts/test-alerts.sh once they are set.
