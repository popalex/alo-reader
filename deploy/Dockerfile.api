# One image, two commands (api / worker). Build context is the repo root.
FROM python:3.14-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

COPY api/pyproject.toml ./pyproject.toml
COPY api/requirements.txt api/requirements-otel.txt ./
COPY api/app ./app
# Dependencies come from the lockfiles, never from pyproject's ranges, so an image
# built today resolves exactly what CI tested. Default build is the lean image; the
# OTel compose overlay sets PIP_REQUIREMENTS to add the OpenTelemetry SDK +
# instrumentation on top.
ARG PIP_REQUIREMENTS="-r requirements.txt"
RUN pip install --no-cache-dir ${PIP_REQUIREMENTS} \
    && pip install --no-cache-dir --no-deps .

# Alembic config + migration scripts: needed by the `migrate` command so the
# image can bring a database up to head on its own.
COPY api/alembic.ini ./alembic.ini
COPY api/migrations ./migrations

COPY deploy/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Drop root: the app writes nothing under /app at runtime (logs go to stdout,
# PYTHONDONTWRITEBYTECODE is set), so a read-only non-root user suffices.
RUN useradd --create-home --uid 10001 app
USER app

EXPOSE 8000
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["api"]
