# Multi-stage: build the SPA with pnpm, then serve it from Caddy.
# Build context is the repo root.
FROM node:24-slim AS build
WORKDIR /web
RUN corepack enable
# The lockfile comes too: without it pnpm resolves fresh from the registry, so the
# bundle CI publishes is built from a different dependency tree than the one every
# other job tested with --frozen-lockfile.
COPY web/package.json web/pnpm-lock.yaml web/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY web/ ./
RUN pnpm build

FROM caddy:2-alpine
COPY --from=build /web/dist /srv
COPY deploy/Caddyfile /etc/caddy/Caddyfile
