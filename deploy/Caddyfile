# Production / `make up`: serve the built SPA and reverse-proxy the API.
#
# The site address comes from ALO_SITE_ADDRESS. Unset, it is `:80` — plain HTTP,
# which is what `make up`, CI and a laptop want. Set it to a hostname you control
# and Caddy obtains and renews a Let's Encrypt certificate on first request, then
# redirects HTTP to HTTPS. That is the whole TLS setup; there is no certificate to
# copy and no renewal cron. Requirements are DNS already pointing here and ports
# 80 and 443 reachable, because the ACME challenge uses both.
#
# Certificates live in Caddy's /data, which docker-compose.yml keeps in a named
# volume. Losing that volume means re-issuing on every container recreate, and
# Let's Encrypt rate-limits duplicate certificates to 5 per week.
#
# The ACME account is anonymous, which is Caddy's default and is valid. There is
# deliberately no ACME_EMAIL variable: both `tls` and the global `email` option
# reject an empty argument, so an optional env-driven address cannot be expressed
# here without a placeholder that expands to a whole directive. If you want the
# expiry warnings, add an `email you@example.com` line to the global options block
# below — Caddy allows exactly one such block and it must come first, so a second
# one is a parse error rather than an addition.
# ── What the error log is allowed to keep ────────────────────────────────────
# There is no access log here, but Caddy's *error* logger attaches the whole
# request to every 5xx — and that means the client address, the full URI with its
# query string, and the headers. A proxy hiccup on /streams/all/entries?q=… would
# therefore write a reader's search terms to disk, which is exactly what the API's
# own log filter and span hook exist to prevent.
#
# So the default logger is filtered rather than silenced: everything after the "?"
# is replaced wholesale, and the headers are dropped. Wholesale rather than a list of
# parameter names to delete, because such a list is only correct until somebody adds
# a parameter — today it is q and cursor, tomorrow it is ?token= and nobody updates
# the filter. The client address stays, in full and
# unmasked, because the thing an operator actually does with these logs is block a
# source that is hammering the box, and a /24 blocks everyone behind the same
# carrier NAT along with them.
#
# Note what this logger does *not* see: a flood of successful requests, or the 429s
# the app's own rate limiter returns, are not errors. The access log below is what
# makes those visible. Rate limiting itself never consults a log — the token bucket
# reads X-Real-IP at request time (auth/middleware.py).
#
# ── Who the client is, behind a proxy ────────────────────────────────────────
# {client_ip} feeds X-Real-IP (the API's per-IP rate limit) and both loggers. Served
# directly, it is the TCP peer. Behind Cloudflare Tunnel every request arrives from
# the cloudflared connector, so without this every visitor would be one address: one
# shared rate-limit bucket (random 429s for everybody) and logs that cannot tell
# anyone apart. From a trusted proxy only, Caddy instead takes the client from
# Cf-Connecting-IP, which Cloudflare's edge sets, falling back to X-Forwarded-For.
#
# ALO_TRUSTED_PROXIES must name the proxy exactly and nothing else: a header from an
# untrusted peer is ignored, but a too-wide range lets anyone inside it claim any
# address. The default is Caddy's own loopback, which no outside request comes from,
# so a stack served directly behaves as before. The tunnel overlay
# (docker-compose.tunnel.yml) pins cloudflared to a fixed address and sets it here.
# The /grafana and /otlp allow-lists deliberately match remote_ip, the TCP peer, not
# this: a forged header must never open them.
{
	servers {
		trusted_proxies static {$ALO_TRUSTED_PROXIES:127.0.0.1/32}
		client_ip_headers Cf-Connecting-Ip X-Forwarded-For
	}

	log {
		format filter {
			wrap console
			fields {
				request>remote_port delete
				request>headers delete
				request>uri regexp "\?.*" "?[scrubbed]"
			}
		}
	}
}

# ── Shared response headers ──────────────────────────────────────────────────
# Imported by both the landing page and the app, so there is one definition of the
# set. /api, /otlp and /grafana stay outside it: the API sends its own headers
# (SecurityHeadersMiddleware) and a second set here would fight it.
(alo_headers) {
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' {$ALO_CLERK_ORIGIN:https://*.clerk.accounts.dev} https://challenges.cloudflare.com; connect-src 'self' {$ALO_CLERK_ORIGIN:https://*.clerk.accounts.dev}; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src {$ALO_CLERK_ORIGIN:https://*.clerk.accounts.dev} https://challenges.cloudflare.com; worker-src 'self' blob:; manifest-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "geolocation=(), camera=(), microphone=(), browsing-topics=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}

# ── What lives at / ──────────────────────────────────────────────────────────
# The landing page exists to turn a stranger into an account, so it belongs to
# AUTH_MODE=clerk and nothing else: a single-user self-host instance has no
# sign-up, and a marketing page in front of your own reader is a wall.
#
# The import below builds a snippet name out of AUTH_MODE itself, so the mode is
# stated once — in .env, where the API already requires it — instead of twice. An
# invalid value fails loudly at boot ("File to import not found: root_<value>"),
# and an unset one never gets that far: caddy waits for a healthy api, and the api
# refuses to start without an explicit AUTH_MODE.
(root_clerk) {
	handle / {
		import alo_headers
		root * /srv
		# Revalidate the landing page on every visit: it is one small document and
		# it is the page most likely to be edited between deploys.
		header Cache-Control "no-cache"
		rewrite * /landing.html
		# For og:image and og:url, which must be absolute: {{.Host}} is this
		# instance's own hostname, so one landing.html serves every deployment.
		templates
		file_server
	}

	# /legal is clerk-only, and not by accident. It describes accounts, an email
	# address, a sign-in provider and a deletion flow, none of which exist in
	# AUTH_MODE=none — a single-user self-host instance would be publishing a
	# privacy policy about a relationship it does not have.
	@legal path /legal /legal.html
	handle @legal {
		import alo_headers
		root * /srv
		header Cache-Control "no-cache"
		rewrite * /legal.html
		templates
		file_server
	}
}

(root_none) {
	# The generic static handler below would happily serve /legal.html in this mode,
	# so it is refused here instead: the page describes accounts and a sign-in
	# provider that do not exist without Clerk.
	@legal path /legal /legal.html
	handle @legal {
		respond 404
	}

	handle / {
		# `redir * /app/ 302`, not `redir /app/ 302`: a destination beginning with a
		# slash parses as a path *matcher*, so the short form means "for requests to
		# /app/, redirect to 302" — it matches nothing here, falls through, and
		# answers an empty 200. Silent, and it cost an afternoon.
		redir * /app/ 302
	}
}

{$ALO_SITE_ADDRESS::80} {
	encode gzip

	# Access log, on purpose and with the same filter as the error logger: the client
	# address in full, everything after the "?" replaced, the headers dropped. Without it the
	# question "which address is making thousands of requests?" has no answer, since
	# a successful flood and a rate-limited one both look like ordinary traffic to the
	# error logger. Docker's json-file driver rotates these (10 MB x 3 per service,
	# see docker-compose.yml), which is the retention the /legal page states.
	log {
		format filter {
			wrap console
			fields {
				request>headers delete
				request>uri regexp "\?.*" "?[scrubbed]"
			}
		}
	}

	# Same-origin OTLP/HTTP endpoint for browser tracing (only used when the OTel
	# overlay runs and /config reports otel_enabled). The rewrite sends
	# /otlp/v1/traces to the collector as /v1/traces. Not handle_path: that strips
	# the whole matched path, which here is all of it, so the collector got "/" and
	# answered 404 to every browser span. Harmless without the
	# overlay — nothing posts here and the upstream is resolved per-request.
	#
	# Traces only, capped, and closed by default. This is an unauthenticated write
	# endpoint: /otlp/* would also expose /v1/logs and /v1/metrics, so anyone could
	# fill Loki and Tempo until the disk goes, or write alo_worker_lag_seconds
	# samples that pin the worker-lag alert at 0 while the worker is dead.
	#
	# A per-request cap bounds one payload, not the total, and Caddy cannot rate limit
	# here (rate_limit is a plugin, not in the standard image). So the far end slows a
	# flood instead — Tempo caps its ingestion rate and expires blocks on the TEMPO_*
	# schedule in docker-compose.otel.yml, which bounds rate x retention rather than
	# disk (see deploy/observability/README.md) — and the route itself is an allow-list
	# like /grafana: loopback by default, so browser spans from real users need
	# ALO_OTLP_ALLOW_IPS widened deliberately.
	handle /otlp/v1/traces {
		@otlp_denied not remote_ip {$ALO_OTLP_ALLOW_IPS:127.0.0.1/32 ::1}
		respond @otlp_denied 403
		request_body {
			max_size 1MB
		}
		rewrite * /v1/traces
		reverse_proxy otel-collector:4318
	}

	# Pass the real client IP to the API for its per-IP pre-auth rate limit.
	# {client_ip} is the direct peer, or the visitor behind a trusted proxy (see the
	# global options), and header_up overwrites any value a client tried to send.
	@api path /api/*
	handle @api {
		# Cap the request body at the edge. The app's own OPML cap (OPML_MAX_BYTES,
		# 1 MiB) is checked after Starlette's multipart parser has already read the
		# upload and spooled anything large to a temp file, so without this an
		# authenticated user could fill the container's disk with one request and
		# never reach the check. 8 MiB leaves room for a large OPML plus multipart
		# framing while staying far below anything that hurts.
		request_body {
			max_size 8MB
		}
		reverse_proxy api:8000 {
			header_up X-Real-IP {client_ip}
		}
	}

	# Grafana (OTel overlay only), served under /grafana over the internal network. The
	# prefix is passed through (Grafana runs with serve_from_sub_path) and Grafana's own
	# login guards it (anonymous access is off). Harmless without the overlay: upstream
	# resolved per-request.
	#
	# Reachable from loopback only unless ALO_GRAFANA_ALLOW_IPS says otherwise. Caddy
	# runs in a container, so "loopback" means a peer inside it — a request the host
	# makes to the published port arrives from the docker bridge gateway and does not
	# match. That is deliberate: get at Grafana on its own loopback-published port
	# (`ssh -L 3001:127.0.0.1:3001`), not through here. A non-matching request falls
	# through to the SPA and gets index.html, so a denial looks like a 200 rather than
	# the 403 /otlp returns — the route has to stay invisible to anyone scanning.
	#
	# The
	# admin password is applied when Grafana FIRST creates its user, so anyone who ran
	# `make otel-up` once before editing .env has admin/admin forever and setting the
	# variable afterwards changes nothing — which is a fine thing to have on a private
	# network and a terrible one to publish. Widen this to your VPN/office CIDR when
	# you actually want remote access.
	@grafana {
		path /grafana*
		remote_ip {$ALO_GRAFANA_ALLOW_IPS:127.0.0.1/32 ::1}
	}
	handle @grafana {
		reverse_proxy otel-lgtm:3000
	}

	# Root behaviour, chosen by AUTH_MODE (see the snippets at the top).
	import root_{$AUTH_MODE:clerk}

	# The app. handle_path strips the prefix, so /app/starred asks the file server
	# for /starred, which try_files resolves to the SPA shell. Vite builds with
	# base=/app/, so every asset request already arrives prefixed.
	redir /app /app/ 308
	handle_path /app/* {
		import alo_headers
		root * /srv
		# The build writes .br and .gz next to every text file, at maximum compression
		# (web/scripts/precompress.mjs). Brotli-11 makes app.js about 15% smaller than
		# the gzip `encode` produces on the fly, and costs nothing per request. Files
		# without a sibling fall back to `encode`.
		#
		# Vite content-hashes every built asset, so a given URL's bytes never change:
		# cache them for a year and immutably. Two rules keep that safe:
		#   - No SPA fallback under /assets/. A missing chunk used to get index.html
		#     with 200 and text/html, which a browser rejects as a module. After a
		#     deploy, an open tab asking for an old chunk would get exactly that.
		#   - Only a 2xx is marked immutable. That fallback page was cached under the
		#     chunk's URL for a year, so even a reload couldn't recover it.
		@assets path /assets/*
		handle @assets {
			header {
				Cache-Control "public, max-age=31536000, immutable"
				match status 2xx
			}
			file_server {
				precompressed br gzip
			}
		}
		# The shell is the opposite: it names the hashed files, so a stale copy pins a
		# user to an old build.
		handle {
			@shell path / /index.html /manifest.webmanifest /sw.js
			header @shell Cache-Control "no-cache"
			try_files {path} /index.html
			file_server {
				precompressed br gzip
			}
		}
	}

	# Bookmarks from before the app moved. Cheap to honour, and the alternative is a
	# 404 on somebody's home-screen shortcut.
	redir /starred /app/starred 301
	redir /feed/* /app{uri} 301
	redir /folder/* /app{uri} 301

	# Root-level files the landing page needs: its script, the favicon, the social
	# card, robots.txt. No try_files fallback here on purpose — an unknown path is a
	# 404, not another copy of the landing page.
	handle {
		import alo_headers
		root * /srv
		# The landing page's script and the icons: unhashed names, so they cannot be
		# immutable, but an hour of caching saves a round trip per visit and bounds
		# how long a change takes to reach someone.
		header Cache-Control "public, max-age=3600"

		# Extensionless URLs for any static page. try_files leaves an unknown path
		# alone, so a typo is still a 404 rather than a copy of some other page.
		try_files {path} {path}.html
		file_server
	}
}
