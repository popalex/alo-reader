# Production / `make up`: serve the built SPA and reverse-proxy the API.
#
# The site address comes from ALO_SITE_ADDRESS. Unset, it is `:80` — plain HTTP,
# which is what `make up`, CI and a laptop want. Set it to a hostname you control
# and Caddy obtains and renews a Let's Encrypt certificate on first request, then
# redirects HTTP to HTTPS. That is the whole TLS setup; there is no certificate to
# copy and no renewal cron. Requirements are DNS already pointing here and ports
# 80 and 443 reachable, because the ACME challenge uses both.
#
# Certificates live in Caddy's /data, which docker-compose.yml keeps in a named
# volume. Losing that volume means re-issuing on every container recreate, and
# Let's Encrypt rate-limits duplicate certificates to 5 per week.
#
# The ACME account is anonymous, which is Caddy's default and is valid. There is
# deliberately no ACME_EMAIL variable: both `tls` and the global `email` option
# reject an empty argument, so an optional env-driven address cannot be expressed
# here without a placeholder that expands to a whole directive. If you want the
# expiry warnings, add a global options block at the top of this file:
#     { email you@example.com }
# ── Shared response headers ──────────────────────────────────────────────────
# Imported by both the landing page and the app, so there is one definition of the
# set. /api, /otlp and /grafana stay outside it: the API sends its own headers
# (SecurityHeadersMiddleware) and a second set here would fight it.
(alo_headers) {
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' {$ALO_CLERK_ORIGIN:https://*.clerk.accounts.dev} https://challenges.cloudflare.com; connect-src 'self' {$ALO_CLERK_ORIGIN:https://*.clerk.accounts.dev}; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src {$ALO_CLERK_ORIGIN:https://*.clerk.accounts.dev} https://challenges.cloudflare.com; worker-src 'self' blob:; manifest-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "geolocation=(), camera=(), microphone=(), browsing-topics=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}

# ── What lives at / ──────────────────────────────────────────────────────────
# The landing page exists to turn a stranger into an account, so it belongs to
# AUTH_MODE=clerk and nothing else: a single-user self-host instance has no
# sign-up, and a marketing page in front of your own reader is a wall.
#
# The import below builds a snippet name out of AUTH_MODE itself, so the mode is
# stated once — in .env, where the API already requires it — instead of twice. An
# invalid value fails loudly at boot ("File to import not found: root_<value>"),
# and an unset one never gets that far: caddy waits for a healthy api, and the api
# refuses to start without an explicit AUTH_MODE.
(root_clerk) {
	handle / {
		import alo_headers
		root * /srv
		rewrite * /landing.html
		file_server
	}
}

(root_none) {
	handle / {
		# `redir * /app/ 302`, not `redir /app/ 302`: a destination beginning with a
		# slash parses as a path *matcher*, so the short form means "for requests to
		# /app/, redirect to 302" — it matches nothing here, falls through, and
		# answers an empty 200. Silent, and it cost an afternoon.
		redir * /app/ 302
	}
}

{$ALO_SITE_ADDRESS::80} {
	encode gzip

	# Same-origin OTLP/HTTP endpoint for browser tracing (only used when the OTel
	# overlay runs and /config reports otel_enabled). handle_path strips /otlp so
	# /otlp/v1/traces reaches the collector as /v1/traces. Harmless without the
	# overlay — nothing posts here and the upstream is resolved per-request.
	#
	# Traces only, capped, and closed by default. This is an unauthenticated write
	# endpoint: /otlp/* would also expose /v1/logs and /v1/metrics, so anyone could
	# fill Loki and Tempo until the disk goes, or write alo_worker_lag_seconds
	# samples that pin the worker-lag alert at 0 while the worker is dead.
	#
	# A per-request cap bounds one payload, not the total, and Caddy cannot rate limit
	# here (rate_limit is a plugin, not in the standard image). So the far end slows a
	# flood instead — Tempo caps its ingestion rate and expires blocks on the TEMPO_*
	# schedule in docker-compose.otel.yml, which bounds rate x retention rather than
	# disk (see deploy/observability/README.md) — and the route itself is an allow-list
	# like /grafana: loopback by default, so browser spans from real users need
	# ALO_OTLP_ALLOW_IPS widened deliberately.
	handle_path /otlp/v1/traces {
		@otlp_denied not remote_ip {$ALO_OTLP_ALLOW_IPS:127.0.0.1/32 ::1}
		respond @otlp_denied 403
		request_body {
			max_size 1MB
		}
		reverse_proxy otel-collector:4318
	}

	# Pass the real client IP to the API for its per-IP pre-auth rate limit. Caddy is
	# the edge, so {client_ip} is the direct peer and header_up overwrites any value a
	# client tried to send. If you later put a CDN/LB in front of Caddy, add a global
	# `servers { trusted_proxies static <cidrs> }` so {client_ip} resolves the true
	# client through X-Forwarded-For.
	@api path /api/*
	handle @api {
		# Cap the request body at the edge. The app's own OPML cap (OPML_MAX_BYTES,
		# 1 MiB) is checked after Starlette's multipart parser has already read the
		# upload and spooled anything large to a temp file, so without this an
		# authenticated user could fill the container's disk with one request and
		# never reach the check. 8 MiB leaves room for a large OPML plus multipart
		# framing while staying far below anything that hurts.
		request_body {
			max_size 8MB
		}
		reverse_proxy api:8000 {
			header_up X-Real-IP {http.request.client_ip}
		}
	}

	# Grafana (OTel overlay only), served under /grafana over the internal network. The
	# prefix is passed through (Grafana runs with serve_from_sub_path) and Grafana's own
	# login guards it (anonymous access is off). Harmless without the overlay: upstream
	# resolved per-request.
	#
	# Reachable from loopback only unless ALO_GRAFANA_ALLOW_IPS says otherwise. Caddy
	# runs in a container, so "loopback" means a peer inside it — a request the host
	# makes to the published port arrives from the docker bridge gateway and does not
	# match. That is deliberate: get at Grafana on its own loopback-published port
	# (`ssh -L 3001:127.0.0.1:3001`), not through here. A non-matching request falls
	# through to the SPA and gets index.html, so a denial looks like a 200 rather than
	# the 403 /otlp returns — the route has to stay invisible to anyone scanning.
	#
	# The
	# admin password is applied when Grafana FIRST creates its user, so anyone who ran
	# `make otel-up` once before editing .env has admin/admin forever and setting the
	# variable afterwards changes nothing — which is a fine thing to have on a private
	# network and a terrible one to publish. Widen this to your VPN/office CIDR when
	# you actually want remote access.
	@grafana {
		path /grafana*
		remote_ip {$ALO_GRAFANA_ALLOW_IPS:127.0.0.1/32 ::1}
	}
	handle @grafana {
		reverse_proxy otel-lgtm:3000
	}

	# Root behaviour, chosen by AUTH_MODE (see the snippets at the top).
	import root_{$AUTH_MODE:clerk}

	# The app. handle_path strips the prefix, so /app/starred asks the file server
	# for /starred, which try_files resolves to the SPA shell. Vite builds with
	# base=/app/, so every asset request already arrives prefixed.
	redir /app /app/ 308
	handle_path /app/* {
		import alo_headers
		root * /srv
		try_files {path} /index.html
		file_server
	}

	# Bookmarks from before the app moved. Cheap to honour, and the alternative is a
	# 404 on somebody's home-screen shortcut.
	redir /starred /app/starred 301
	redir /feed/* /app{uri} 301
	redir /folder/* /app{uri} 301

	# Root-level files the landing page needs: its script, the favicon, the social
	# card, robots.txt. No try_files fallback here on purpose — an unknown path is a
	# 404, not another copy of the landing page.
	handle {
		import alo_headers
		root * /srv
		file_server
	}
}
