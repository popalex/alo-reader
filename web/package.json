{
  "name": "alo-reader-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tsc": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "name": "main app (initial JS + CSS, gzip)",
      "path": [
        "dist/assets/app-*.js",
        "dist/assets/index-*.css"
      ],
      "gzip": true,
      "limit": "180 kB"
    }
  ],
  "dependencies": {
    "@clerk/clerk-react": "^5.61.9",
    "@fontsource-variable/inter": "^5.3.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-zone": "^2.11.0",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation": "^0.222.0",
    "@opentelemetry/instrumentation-fetch": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace-web": "^2.11.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.35",
    "@tanstack/react-virtual": "^3.14.11",
    "dompurify": "^3.4.15",
    "idb": "^8.0.3",
    "lucide-react": "^1.44.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@size-limit/file": "^12.1.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "size-limit": "^12.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  }
}
